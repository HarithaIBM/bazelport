diff --git a/src/main/java/com/google/devtools/build/lib/packages/Package.java b/src/main/java/com/google/devtools/build/lib/packages/Package.java
old mode 100644
new mode 100755
index 3f228f2..23b2798
--- a/src/main/java/com/google/devtools/build/lib/packages/Package.java
+++ b/src/main/java/com/google/devtools/build/lib/packages/Package.java
@@ -359,7 +359,18 @@ public class Package {
 
     this.containsErrors |= builder.containsErrors;
     if (directLoads == null && transitiveLoads == null) {
-      Preconditions.checkState(containsErrors, "Loads not set for error-free package");
+      // Z/OS BOOTSTRAP PATCH: Allow null loads in bootstrap mode
+      // In bootstrap mode, .bzl files can't be loaded due to circular dependencies
+      // So we skip the check and just set empty loads
+      String zosBootstrapMode = System.getProperty("ZOS_BOOTSTRAP_MODE");
+      boolean isBootstrap = "true".equals(zosBootstrapMode);
+      
+      if (!isBootstrap) {
+        // Normal mode: enforce the check
+        Preconditions.checkState(containsErrors, "Loads not set for error-free package");
+      }
+      // END Z/OS BOOTSTRAP PATCH
+      
       builder.setLoads(ImmutableList.of());
     }
 
