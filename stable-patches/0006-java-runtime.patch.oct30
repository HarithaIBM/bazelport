diff --git a/src/main/java/com/google/devtools/build/lib/exec/FileWriteStrategy.java b/src/main/java/com/google/devtools/build/lib/exec/FileWriteStrategy.java
old mode 100644
new mode 100755
index dce4893..56b87f3
--- a/src/main/java/com/google/devtools/build/lib/exec/FileWriteStrategy.java
+++ b/src/main/java/com/google/devtools/build/lib/exec/FileWriteStrategy.java
@@ -62,6 +62,24 @@ public final class FileWriteStrategy implements FileWriteActionContext {
         if (makeExecutable) {
           outputPath.setExecutable(true);
         }
+        // z/OS: Tag the file as ISO8859-1 (ASCII) so that the kernel's exec()
+        // can parse the shebang line. Without this, untagged files are read
+        // as EBCDIC, causing "EDC5130I Exec format error" for generated
+        // scripts (java_binary launchers, python wrappers, etc.).
+        if (System.getProperty("os.name").toLowerCase().contains("z/os")
+            || System.getProperty("os.name").toLowerCase().contains("os/390")) {
+          try {
+            String absPath = new java.io.File(outputPath.getPathString()).getAbsolutePath();
+            ProcessBuilder pb =
+                new ProcessBuilder("/bin/chtag", "-tc", "ISO8859-1", absPath);
+            pb.redirectErrorStream(true);
+            Process tagProcess = pb.start();
+            tagProcess.waitFor();
+          } catch (Exception e) {
+            // Best effort — if chtag fails, the file may still work if
+            // the system is configured for auto-conversion.
+          }
+        }
       } catch (IOException e) {
         throw new EnvironmentalExecException(e, Code.FILE_WRITE_IO_EXCEPTION);
       }
