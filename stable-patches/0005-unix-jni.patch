+#ifdef __MVS__
+// ---- z/OS compatibility for the *at() syscall family ---------------------
+// z/OS USS does not provide dirfd(3), fdopendir(3), openat(2), fstatat(2),
+// fchmodat(2), unlinkat(2) or utimensat(2). All callers in this file keep
+// the directory path (dir_path) alongside the descriptor, so the fallbacks
+// below operate on full paths instead.
+#include <sys/time.h>
+
+#ifndef AT_FDCWD
+#define AT_FDCWD (-100)
+#endif
+#ifndef AT_REMOVEDIR
+#define AT_REMOVEDIR 2
+#endif
+#ifndef AT_SYMLINK_NOFOLLOW
+#define AT_SYMLINK_NOFOLLOW 0x100
+#endif
+#ifndef O_NOFOLLOW
+#define O_NOFOLLOW 0
+#endif
+
+// z/OS DIR* is opaque and cannot be converted to a descriptor; the fallback
+// implementations ignore it.
+#define dirfd(d) (-1)
+
+static inline std::string zos_join(
+    const std::vector<std::string>& dir_path, const char* entry) {
+  std::string result;
+  for (const auto& c : dir_path) {
+    if (!result.empty()) result += '/';
+    result += c;
+  }
+  if (entry != nullptr) {
+    if (!result.empty()) result += '/';
+    result += entry;
+  }
+  return result;
+}
+
+// utimensat is only used with AT_FDCWD in this file.
+static inline int zos_utimensat_cwd(const char* path,
+                                    const struct timespec ts[2], int flags) {
+  struct timeval tv[2];
+  tv[0].tv_sec = ts[0].tv_sec;
+  tv[0].tv_usec = ts[0].tv_nsec / 1000;
+  tv[1].tv_sec = ts[1].tv_sec;
+  tv[1].tv_usec = ts[1].tv_nsec / 1000;
+  return utimes(path, tv);
+}
+#define utimensat(dirfd_, path, ts, flags) zos_utimensat_cwd(path, ts, flags)
+#endif  // __MVS__
