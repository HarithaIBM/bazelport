+#define ru_inblock ru_utime.tv_sec
+#define ru_oublock ru_utime.tv_sec
+#define ru_msgsnd ru_utime.tv_sec
+#define ru_msgrcv ru_utime.tv_sec
+#define ru_nsignals ru_utime.tv_sec
+#define ru_nvcsw ru_utime.tv_sec
+#define ru_nivcsw ru_utime.tv_sec
+#endif
