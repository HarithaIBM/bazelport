@@ -14,6 +14,39 @@
 
 #include "src/main/tools/process-tools.h"
 
+#ifdef __MVS__
+// z/OS USS lacks NSIG, wait4 and several struct rusage members.
+#include <sys/resource.h>
+#include <sys/wait.h>
+#ifndef NSIG
+#define NSIG 64
+#endif
+#define wait4(pid, status, options, rusage) \
+  zos_wait4(pid, status, options, rusage)
+static inline pid_t zos_wait4(pid_t pid, int* status, int options,
+                              struct rusage* ru) {
+  pid_t r = waitpid(pid, status, options);
+  if (r >= 0 && ru != nullptr) {
+    getrusage(RUSAGE_CHILDREN, ru);
+  }
+  return r;
+}
+#define ru_maxrss ru_utime.tv_sec  /* unused on z/OS; remapped to dummy */
+#define ru_ixrss ru_utime.tv_sec
