diff --git a/src/main/tools/process-tools.cc b/src/main/tools/process-tools.cc
old mode 100644
new mode 100755
index dae919d..e6da1d0
--- a/src/main/tools/process-tools.cc
+++ b/src/main/tools/process-tools.cc
@@ -14,6 +14,39 @@
 
 #include "src/main/tools/process-tools.h"
 
+#ifdef __MVS__
+// z/OS USS lacks NSIG, wait4 and several struct rusage members.
+#include <sys/resource.h>
+#include <sys/wait.h>
+#ifndef NSIG
+#define NSIG 64
+#endif
+#define wait4(pid, status, options, rusage) \
+  zos_wait4(pid, status, options, rusage)
+static inline pid_t zos_wait4(pid_t pid, int* status, int options,
+                              struct rusage* ru) {
+  pid_t r = waitpid(pid, status, options);
+  if (r >= 0 && ru != nullptr) {
+    getrusage(RUSAGE_CHILDREN, ru);
+  }
+  return r;
+}
+#define ru_maxrss ru_utime.tv_sec  /* unused on z/OS; remapped to dummy */
+#define ru_ixrss ru_utime.tv_sec
+#define ru_idrss ru_utime.tv_sec
+#define ru_isrss ru_utime.tv_sec
+#define ru_nswap ru_utime.tv_sec
+#define ru_minflt ru_utime.tv_sec
+#define ru_majflt ru_utime.tv_sec
+#define ru_inblock ru_utime.tv_sec
+#define ru_oublock ru_utime.tv_sec
+#define ru_msgsnd ru_utime.tv_sec
+#define ru_msgrcv ru_utime.tv_sec
+#define ru_nsignals ru_utime.tv_sec
+#define ru_nvcsw ru_utime.tv_sec
+#define ru_nivcsw ru_utime.tv_sec
+#endif
+
 #include <errno.h>
 #include <fcntl.h>
 #include <math.h>
