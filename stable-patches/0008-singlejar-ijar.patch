diff --git a/src/tools/singlejar/options.cc b/src/tools/singlejar/options.cc
old mode 100644
new mode 100755
index 2728af3..84fae4c
--- a/src/tools/singlejar/options.cc
+++ b/src/tools/singlejar/options.cc
@@ -23,7 +23,16 @@ void Options::ParseCommandLine(int argc, const char *const argv[]) {
     if (ParseToken(&tokens)) {
       continue;
     } else {
-      diag_errx(1, "Bad command line argument %s", tokens.token().c_str());
+      // z/OS: Skip unknown arguments (e.g. --native_header_output,
+      // --output_manifest_proto) that are passed by the java_binary rule
+      // but not supported by this singlejar build. Also skip the argument's
+      // value if the next token doesn't start with '--'.
+      diag_warn("Skipping unknown argument: %s", tokens.token().c_str());
+      tokens.next();
+      // If the next token is a value (not a --flag), skip it too
+      if (!tokens.AtEnd() && tokens.token().c_str()[0] != '-') {
+        tokens.next();
+      }
     }
   }
 
