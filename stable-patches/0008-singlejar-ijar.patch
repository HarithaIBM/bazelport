diff --git a/src/tools/singlejar/diag.h b/src/tools/singlejar/diag.h
old mode 100644
new mode 100755
index ee0793a..aa22ccc
--- a/src/tools/singlejar/diag.h
+++ b/src/tools/singlejar/diag.h
@@ -28,6 +28,28 @@
 #define diag_warn(...) warn(__VA_ARGS__)
 #define diag_warnx(...) warnx(__VA_ARGS__)
 
+#elif defined(__MVS__)
+
+// z/OS USS does not provide err.h; minimal equivalents of the BSD err(3) family.
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define diag_err(exit_value, fmt, ...)                                       \
+  {                                                                           \
+    fprintf(stderr, "ERROR: " fmt ": %s\n", ##__VA_ARGS__, strerror(errno)); \
+    exit(exit_value);                                                         \
+  }
+#define diag_errx(exit_value, fmt, ...)                    \
+  {                                                        \
+    fprintf(stderr, "ERROR: " fmt "\n", ##__VA_ARGS__);   \
+    exit(exit_value);                                      \
+  }
+#define diag_warn(fmt, ...) \
+  fprintf(stderr, "WARNING: " fmt ": %s\n", ##__VA_ARGS__, strerror(errno))
+#define diag_warnx(fmt, ...) \
+  fprintf(stderr, "WARNING: " fmt "\n", ##__VA_ARGS__)
+
 #elif defined(_WIN32)
 
 #ifndef WIN32_LEAN_AND_MEAN
