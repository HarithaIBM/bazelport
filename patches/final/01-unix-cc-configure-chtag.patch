--- a/tools/cpp/unix_cc_configure.bzl
+++ b/tools/cpp/unix_cc_configure.bzl
@@ -380,6 +380,14 @@ def configure_unix_toolchain(repository_ctx, cpu_value, overridden_tools):
         if not tool_path:
             continue
         
+        # z/OS: Tag shell scripts as ASCII (ISO8859-1) for proper execution
+        if tool.endswith(".sh"):
+            script_path = repository_ctx.path(tool_path)
+            repository_ctx.execute([
+                "chtag", "-tc", "ISO8859-1", str(script_path)
+            ])
+            repository_ctx.execute(["chmod", "+x", str(script_path)])
+        
         tool_paths[tool] = tool_path
     
     return tool_paths
