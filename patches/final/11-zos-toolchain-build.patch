--- /dev/null
+++ b/zos_toolchain/BUILD
@@ -0,0 +1,57 @@
+"""z/OS Java runtime toolchain for Bazel."""
+
+load("@rules_java//java:defs.bzl", "java_runtime")
+load(":constraints.bzl", "define_zos_platform")
+
+# Define z/OS platform constraints
+define_zos_platform()
+
+# Define the Java runtime pointing to system Java 21
+java_runtime(
+    name = "zos_jdk21_runtime",
+    java_home = "/usr/lpp/java/J21.0_64",
+    version = 21,
+    visibility = ["//visibility:public"],
+)
+
+# Create toolchain for runtime (execution)
+toolchain(
+    name = "zos_java_runtime_toolchain",
+    exec_compatible_with = [
+        ":is_zos",
+        "@platforms//cpu:s390x",
+    ],
+    target_compatible_with = [
+        ":is_zos",
+        "@platforms//cpu:s390x",
+    ],
+    toolchain = ":zos_jdk21_runtime",
+    toolchain_type = "@bazel_tools//tools/jdk:runtime_toolchain_type",
+    visibility = ["//visibility:public"],
+)
+
+# Also create toolchain for bootstrap runtime
+toolchain(
+    name = "zos_java_bootstrap_runtime_toolchain",
+    exec_compatible_with = [
+        ":is_zos",
+        "@platforms//cpu:s390x",
+    ],
+    target_compatible_with = [
+        ":is_zos",
+        "@platforms//cpu:s390x",
+    ],
+    toolchain = ":zos_jdk21_runtime",
+    toolchain_type = "@bazel_tools//tools/jdk:bootstrap_runtime_toolchain_type",
+    visibility = ["//visibility:public"],
+)
+
+# Export the platform for registration
+platform(
+    name = "zos_platform",
+    constraint_values = [
+        ":is_zos",
+        "@platforms//cpu:s390x",
+    ],
+    visibility = ["//visibility:public"],
+)
