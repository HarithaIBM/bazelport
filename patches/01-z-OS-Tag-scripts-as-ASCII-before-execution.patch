-"""Configuring the C++ toolchain on Unix platforms."""
-
-load(
-    "@bazel_tools//tools/cpp:lib_cc_configure.bzl",
-    "auto_configure_fail",
-    "auto_configure_warning",
-    "auto_configure_warning_maybe",
-    "escape_string",
