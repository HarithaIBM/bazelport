# Sample project built with the z/OS Bazel port.
#
# Covers the common rule types usable on z/OS:
#   - cc_binary / cc_library (IBM Open Enterprise LLVM clang, ASCII mode)
#   - genrule (host tools, ASCII shell scripts)
#   - sh_binary (zopen bash)
package(default_visibility = ["//visibility:public"])

# ---------------------------------------------------------------------------
# C++: a tiny library + binary
# ---------------------------------------------------------------------------
cc_library(
    name = "greeting",
    srcs = ["cpp/greeting.cc"],
    hdrs = ["cpp/greeting.h"],
)

cc_binary(
    name = "hello_cc",
    srcs = ["cpp/hello.cc"],
    deps = [":greeting"],
)

# ---------------------------------------------------------------------------
# genrule: generate a source file at build time (uses python3 from the PATH
# the bazel server was started with)
# ---------------------------------------------------------------------------
genrule(
    name = "gen_version",
    srcs = [],
    outs = ["cpp/generated_version.cc"],
    cmd = """
      echo '// generated by genrule' > $@
      echo 'const char* BuildStamp() { return "genrule-sample"; }' >> $@
    """,
)

cc_binary(
    name = "hello_generated",
    srcs = ["cpp/hello_generated.cc", ":gen_version"],
)

# ---------------------------------------------------------------------------
# Shell: run with zopen bash
# ---------------------------------------------------------------------------
sh_binary(
    name = "hello_sh",
    srcs = ["sh/hello.sh"],
)
