# ============================================================================
export BAZELPORT_ROOT="${BAZELPORT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)}"
export JAVA_HOME="${JAVA_HOME:-/home/haritha/dhjava/J21.0_64}"
export PYTHON_HOME="${PYTHON_HOME:-/home/haritha/bazelDepTools/python}"
export COMPILER_PATH="${COMPILER_PATH:-/home/haritha/install_test/usr/lpp/IBM/oelcpp/v3r0/bin/clang}"
export ZOPEN_ROOTFS="${ZOPEN_ROOTFS:-}"


# ============================================================================
# Full Bazel build: Stage 1 (bootstrap) + Stage 2 (Bazel builds itself).
#
# The bootstrap jar (output/libblaze.jar) is an INTERMEDIATE artifact only.
# The final product of this port is output/bazel — the Stage 2 binary built
# by the bootstrap Bazel driving the real Bazel build (src:bazel_nojdk).
#
# This function mirrors the verified run_stage2.sh flow.
# ============================================================================
zopen_bazel_make() {
    echo "==== Bazel Full Build (Stage 1 + Stage 2) ===="

    # If zopen trapped us in the .bazelci subfolder, step out to the real root
    if [ ! -f "compile.sh" ] && [ -f "../compile.sh" ]; then
        cd ..
    fi

    # --- toolchain environment ---
    # zopen rootfs: honor ZOPEN_ROOTFS, else known-good local locations.
    # Detection requires a working GNU grep (zopen puts GNU coreutils/grep/
    # findutils in usr/local/altbin; usr/local/bin only has ggrep/gfind).
    if [ -z "${ZOPEN_ROOTFS}" ]; then
        for d in /data/zopen /home/haritha/zopen_23may/zopen; do
            [ -x "$d/usr/local/altbin/grep" ] && ZOPEN_ROOTFS="$d" && break
        done
    fi
    ZOPEN_ROOTFS="${ZOPEN_ROOTFS:-/data/zopen}"
    # python3 for build actions (build_tar wrappers, genrules). The wrapper
    # sets LIBPATH itself — bazel action spawns don't inherit the server's.
    export PYTHON_BIN_PATH="${PYTHON_BIN_PATH:-${BAZELPORT_ROOT}/local_repos/python_wrapper/python3}"
    export LIBPATH="${PYTHON_HOME}/lib:${LIBPATH:-}"
    # NOTE: altbin MUST come first — the z/OS USS tools in /bin (FSUM) don't
    # support grep -o or find -mindepth, which Stage 1's link_file/embedding
    # steps require.
    export PATH="${ZOPEN_ROOTFS}/usr/local/altbin:${JAVA_HOME}/bin:${BAZELPORT_ROOT}/local_repos/python_wrapper:${ZOPEN_ROOTFS}/usr/local/bin:$(dirname "$COMPILER_PATH"):$PATH"
    export CC=${CC:-clang}
    export CXX=${CXX:-clang++}
    # z/OS: identify the libc to the auto-configured cc toolchain
    export BAZEL_TARGET_LIBC=zos
    export LC_ALL=${LC_ALL:-C.UTF-8}
    # z/OS: Tag generated scripts for exec() but don't corrupt binary file reads
    export _TAG_REDIR_IN=txt=ISO8859-1
    export _TAG_REDIR_OUT=bin
    unset _TAG_REDIR_ALL
    export JAVA_TOOL_OPTIONS="-Dfile.encoding=UTF-8 ${JAVA_TOOL_OPTIONS:-}"
    # Explicit annotation processors (discovery is unreliable on z/OS javac)
    export BAZEL_JAVAC_OPTS="-processor com.google.auto.value.processor.AutoValueProcessor,com.google.auto.value.processor.AutoOneOfProcessor -J-Xmx4g -J-Xms2g"
    export EXTRA_BAZEL_ARGS="--tool_java_runtime_version=local_jdk --java_runtime_version=local_jdk --spawn_strategy=standalone --features=no_dotd_file --cxxopt=-std=c++17 --host_cxxopt=-std=c++17 --@rules_jvm_external//settings:stamp_manifest=False"
    export VERBOSE=${VERBOSE:-no}

    # CRITICAL: normal mode for Stage 2 (full WORKSPACE machinery).
    # Never leave ZOS_BOOTSTRAP_MODE set here — that would stop at the
    # bootstrap jar and treat Stage 1 as the final product.
    unset ZOS_BOOTSTRAP_MODE

    hash -r
    chmod +x compile.sh

    echo "Running FULL Bazel compile.sh in $(pwd)..."
    bash ./compile.sh
    rc=$?
    if [ $rc -ne 0 ]; then
        echo "ERROR: compile.sh failed with exit code $rc" >&2
        return $rc
    fi

    # Final artifact check: must be the Stage 2 binary, NOT the bootstrap jar.
    if [ ! -f "output/bazel" ]; then
        echo "ERROR: output/bazel (Stage 2 binary) was not created — build did not complete Stage 2" >&2
        return 1
    fi
    if [ ! -s "output/bazel" ]; then
        echo "ERROR: output/bazel is empty" >&2
        return 1
    fi
    echo "Stage 2 complete: output/bazel ($(ls -l output/bazel | awk '{print $5}') bytes)"
    return 0
}

# Custom install step: install the Stage 2 binary
zopen_bazel_install() {
    # Step out to the real root if needed
    if [ ! -d "output" ] && [ -d "../output" ]; then
        cd ..
    fi

    # Refuse to install unless the Stage 2 binary exists — the bootstrap
    # jar (output/libblaze.jar) is never a valid install artifact.
    if [ ! -f "output/bazel" ]; then
        echo "ERROR: output/bazel not found — refusing to install (bootstrap-only builds are not final)" >&2
        return 1
    fi

    echo "Installing Bazel (Stage 2 binary) from $(pwd)..."
    mkdir -p "${ZOPEN_INSTALL_DIR}/bin"
    cp output/bazel "${ZOPEN_INSTALL_DIR}/bin/"
}
