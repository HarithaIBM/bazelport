zopen_init(){
  # Apply z/OS specific patches for protobuf compatibility
  echo "Setting up z/OS build configuration..." >&2
  
  # Set UTF-8 locale for build
  export LC_ALL=C.UTF-8 2>/dev/null || export LC_ALL=C
  export LANG=C.UTF-8 2>/dev/null || export LANG=C
  
  # Set Java encoding to UTF-8
  export JAVA_TOOL_OPTIONS="-Dfile.encoding=UTF-8 ${JAVA_TOOL_OPTIONS:-}"
  
  # Suppress IFA processor warning
  export _JVM_OPTIONS="-Xnoifa ${_JVM_OPTIONS:-}"
  
  # Add z/OS configuration to Bazel args
  export EXTRA_BAZEL_ARGS="${EXTRA_BAZEL_ARGS:-} --config=zos"
  
  echo "[zopen_init] Using unzip from PATH: $(which unzip)" >&2
  echo "[zopen_init] Locale: ${LC_ALL}" >&2
  echo "[zopen_init] Java encoding: UTF-8" >&2
  echo "Using EXTRA_BAZEL_ARGS: $EXTRA_BAZEL_ARGS" >&2
}

zopen_post_buildenv(){
  ## This function runs after the 'buildenv' is processed.
  echo "[zopen_post_buildenv] Using system unzip: $(which unzip)" >&2
}

zopen_unpack_zip(){
  ## Custom unpack for zip files - use -o to overwrite without prompting
  local zipfile="$1"
  local targetdir="$2"
  
  echo "[zopen_unpack_zip] Extracting $zipfile to $targetdir" >&2
  mkdir -p "$targetdir" || return 1
  cd "$targetdir" || return 1
  
  # Use -o flag to overwrite without prompting
  unzip -o -q "../$zipfile" || {
    echo "[zopen_unpack_zip] ERROR: unzip failed" >&2
    return 1
  }
  
  echo "[zopen_unpack_zip] Extraction complete" >&2
  return 0
}

zopen_post_extract(){
  ## This function runs after the source tarball is extracted.
  ## With ZOPEN_EXTRACT_DIR set, files are already in .bazelci directory!
  local sourcedir="$1"
  
  echo "[zopen_post_extract] sourcedir: ${sourcedir}" >&2
  echo "[zopen_post_extract] pwd: $(pwd)" >&2
  
  # DON'T cd here - let extractTarBall handle it!
  # cd "${sourcedir}" || return 1
  
  echo "[zopen_post_extract] Files in directory: $(ls -1 ${sourcedir} 2>/dev/null | wc -l)" >&2
  
  # Normalize file permissions BEFORE git commit
  # Git patches expect specific file modes
  echo "[zopen_post_extract] Normalizing file permissions..." >&2
  if [ -f "${sourcedir}/tools/cpp/unix_cc_configure.bzl" ]; then
    chmod 644 "${sourcedir}/tools/cpp/unix_cc_configure.bzl" 2>/dev/null || true
  fi
  
  # Comprehensive file tagging for z/OS
  echo "[zopen_post_extract] Applying z/OS file tags..." >&2
  
  # Tag ALL shell scripts as ASCII (critical for bootstrap)
  find "${sourcedir}" -name "*.sh" -exec chtag -tc ISO8859-1 {} \; 2>/dev/null || true
  
  # Tag Java source files as UTF-8
  find "${sourcedir}" -name "*.java" -exec chtag -tc UTF-8 {} \; 2>/dev/null || true
  
  # Tag Python scripts as UTF-8
  find "${sourcedir}" -name "*.py" -exec chtag -tc UTF-8 {} \; 2>/dev/null || true
  
  # Tag binary files
  if [ -d "${sourcedir}/derived" ]; then
    echo "[zopen_post_extract] Tagging binary files in derived/..." >&2
    find "${sourcedir}/derived" \( -name "*.jar" -o -name "*.class" -o -name "*.so" -o -name "*.a" \) \
      -exec chtag -b {} \; 2>/dev/null || true
  fi
  
  # Tag all .jar and .class files as binary
  find "${sourcedir}" -type f \( -name "*.jar" -o -name "*.class" \) \
    -exec chtag -b {} \; 2>/dev/null || true
  
  # Ensure bootstrap scripts are executable and properly tagged
  if [ -f "${sourcedir}/scripts/bootstrap/buildenv.sh" ]; then
    echo "[zopen_post_extract] Setting up bootstrap scripts..." >&2
    chmod +x "${sourcedir}/scripts/bootstrap/buildenv.sh"
    chmod +x "${sourcedir}/scripts/bootstrap/compile.sh"
    chtag -tc ISO8859-1 "${sourcedir}/scripts/bootstrap/buildenv.sh"
    chtag -tc ISO8859-1 "${sourcedir}/scripts/bootstrap/compile.sh"
  fi
  
  # Tag compile.sh if it exists at root
  if [ -f "${sourcedir}/compile.sh" ]; then
    chmod +x "${sourcedir}/compile.sh"
    chtag -tc ISO8859-1 "${sourcedir}/compile.sh"
  fi
  
  echo "[zopen_post_extract] File tagging completed" >&2
  return 0
}



