zopen_build() {
  echo "[zopen_build] Starting Bazel bootstrap compilation..." >&2
  
  cd .bazelci || {
    echo "[zopen_build] ERROR: .bazelci directory not found" >&2
    return 1
  }
  
  # Create output directory for artifacts
  mkdir -p ../output
  
  # ONLY do bootstrap compilation, NOT Bazel-on-Bazel rebuild
  # This avoids the IBM J9 GC runtime issues in the second stage
  echo "[zopen_build] Running bootstrap compilation (stage 1 only)..." >&2
  
  bash -c '
    set -e
    
    # Critical: unset this variable or compilation will be skipped!
    unset BAZEL_SKIP_JAVA_COMPILATION
    
    echo "[bootstrap] Sourcing buildenv.sh..." >&2
    source scripts/bootstrap/buildenv.sh
    
    echo "[bootstrap] OUTPUT_DIR=${OUTPUT_DIR}" >&2
    
    echo "[bootstrap] Sourcing compile.sh..." >&2
    source scripts/bootstrap/compile.sh
    
    # libblaze.jar is in OUTPUT_DIR/archive/ after compilation
    ARCHIVE_DIR="${OUTPUT_DIR}/archive"
    
    # Copy libblaze.jar if it was created
    if [ -f "${ARCHIVE_DIR}/libblaze.jar" ]; then
      echo "[bootstrap] SUCCESS! Copying libblaze.jar..." >&2
      cp "${ARCHIVE_DIR}/libblaze.jar" ../output/libblaze.jar
      ls -lh ../output/libblaze.jar >&2
    elif [ -f "${OUTPUT_DIR}/libblaze.jar" ]; then
      echo "[bootstrap] Found libblaze.jar in OUTPUT_DIR (fallback)" >&2
      cp "${OUTPUT_DIR}/libblaze.jar" ../output/libblaze.jar
      ls -lh ../output/libblaze.jar >&2
    else
      echo "[bootstrap] ERROR: libblaze.jar not found in ${ARCHIVE_DIR} or ${OUTPUT_DIR}" >&2
      exit 1
    fi
    
    # Also copy the bazel wrapper script if it exists
    if [ -f "${ARCHIVE_DIR}/bazel" ]; then
      cp "${ARCHIVE_DIR}/bazel" ../output/bazel
      chmod +x ../output/bazel
      echo "[bootstrap] Copied bazel wrapper" >&2
    fi
  '
  
  local rc=$?
  cd ..
  
  if [ $rc -eq 0 ]; then
    echo "[zopen_build] Bootstrap completed successfully!" >&2
  else
    echo "[zopen_build] Bootstrap failed with rc=$rc" >&2
  fi
  
  return $rc
}

