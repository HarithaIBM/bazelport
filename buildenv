# ============================================================================
# zopen framework bug workaround — MUST run at source time (before zopen's
# extract step). zopen-build's extract cleanup is `rm -rf "${noext}/*"` —
# the quoted glob removes nothing — and it runs `unzip` without `-o`, so a
# re-run after a failed/interrupted attempt finds leftover files and unzip
# waits FOREVER on an invisible overwrite prompt (stdout captured, stderr
# discarded). Clean previous-extract state here so every run starts fresh
# (the same guarantee Jenkins gets from deleteDir()).
# ============================================================================
if [ -f "./buildenv" ] && [ -d "./stable-patches" ]; then
    # we are in the port root at zopen build startup
    # repo files that ALSO exist in the bazel dist zip (CODEOWNERS,
    # CONTRIBUTING.md, LICENSE, README.md): unzip would prompt an invisible
    # "replace?" on them and hang forever when stdin is a terminal.
    # Remove them here — the dist extract provides the build's copies,
    # and git restores the repo's copies at any time.
    for _f in CODEOWNERS CONTRIBUTING.md LICENSE README.md; do
        [ -f "./$_f" ] && rm -f "./$_f"
    done
    unset _f
    if [ -d "./.bazelci" ]; then
        echo "note: removing stale .bazelci (zopen extract-cleanup workaround)"
        rm -rf "./.bazelci"
    fi
    # leftover dist-extract at the port root (from an interrupted run):
    # compile.sh+src exist only after an extract — the repo itself has neither
    if [ -f "./compile.sh" ] && [ -d "./src/main/cpp" ]; then
        echo "note: removing stale dist extract at port root"
        rm -rf ./src ./tools ./scripts ./third_party ./derived ./examples \
              ./site ./zos_toolchain ./pre_generated_protos ./local_repos \
              ./compile.sh ./WORKSPACE ./WORKSPACE.bzlmod ./MODULE.bazel \
              ./MODULE.bazel.lock ./BUILD ./create_rules_java_builtin.sh \
              ./bazel_downloader.cfg ./AUTHORS ./CHANGELOG.md ./CODEOWNERS \
              ./CODE_OF_CONDUCT.md ./CONTRIBUTORS ./LICENSE ./README.md \
              ./SECURITY.md ./requirements.txt ./extensions.bzl ./repositories.bzl \
              ./workspace_deps.bzl ./distdir.bzl ./distdir_deps.bzl \
              ./maven_install.json ./rbe_extension.bzl ./combine_distfiles.py
    fi
fi
# ============================================================================
# Toolchain locations — everything is configurable via environment variables.
# No hardcoded user paths. Values are auto-detected where possible; the build
# fails fast with a clear message when something cannot be found.
#
#   BAZELPORT_ROOT  port root (marker: local_repos/ + stable-patches/)
#   JAVA_HOME       Java 21 JDK (bootstrap javac + local_jdk runtime)
#   PYTHON_HOME     IBM Open Enterprise SDK for Python (bazel build actions)
#   COMPILER_PATH   z/OS clang (ASCII mode) driver
#   ZOPEN_ROOTFS    zopen rootfs (GNU tools in usr/local/altbin, packages
#                   under usr/local/zopen/<pkg>/<pkg>-<ver>.zos)
#   ZOSLIB_HOME     zoslib package dir      (default: auto under ZOPEN_ROOTFS)
#   GRPC_HOME       zopen gRPC package dir  (default: auto under ZOPEN_ROOTFS)
#   SQLITE_HOME     zopen sqlite package dir(default: auto under ZOPEN_ROOTFS)
#   OPENSSL_HOME    zopen openssl package dir(default: auto under ZOPEN_ROOTFS)
# ============================================================================

# --- BAZELPORT_ROOT: marker-based detection (zopen may source this file
# --- from an arbitrary context where BASH_SOURCE/cwd do not point at the port)
if [ -z "${BAZELPORT_ROOT:-}" ]; then
    BAZELPORT_ROOT=""
    _be_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd)"
    for _d in "${_be_dir}" "$PWD" "$PWD/.." "$(dirname "${_be_dir}" 2>/dev/null)"; do
        if { [ -d "${_d}/local_repos" ] || [ -d "${_d}/deps" ]; } && [ -d "${_d}/stable-patches" ]; then
            BAZELPORT_ROOT="${_d}"
            break
        fi
    done
fi
if [ -z "${BAZELPORT_ROOT}" ] || { [ ! -d "${BAZELPORT_ROOT}/local_repos" ] && [ ! -d "${BAZELPORT_ROOT}/deps" ]; }; then
    echo "ERROR: cannot locate the bazelport root (needs local_repos/ and stable-patches/). Set BAZELPORT_ROOT." >&2
    return 1 2>/dev/null || exit 1
fi
export BAZELPORT_ROOT

# --- JAVA_HOME: env, else derive from `java` on PATH
if [ -z "${JAVA_HOME:-}" ]; then
    if _java="$(command -v java 2>/dev/null)" && [ -n "$_java" ]; then
        JAVA_HOME="$(cd "$(dirname "$_java")/.." && pwd)"
    else
        echo "ERROR: JAVA_HOME not set and no java found on PATH." >&2
        return 1 2>/dev/null || exit 1
    fi
fi
export JAVA_HOME

# --- COMPILER_PATH: env, else `clang` from PATH
if [ -z "${COMPILER_PATH:-}" ]; then
    if ! COMPILER_PATH="$(command -v clang 2>/dev/null)"; then
        echo "ERROR: COMPILER_PATH not set and no clang found on PATH." >&2
        return 1 2>/dev/null || exit 1
    fi
fi
export COMPILER_PATH

# --- PYTHON_HOME: must point at the IBM Open Enterprise SDK for Python
# --- (a z/OS program-object python whose DLLs need LIBPATH; the port's
# --- python_wrapper handles that for bazel action spawns)
if [ -z "${PYTHON_HOME:-}" ] || [ ! -x "${PYTHON_HOME}/bin/python3" ]; then
    # Probe the host-built python wrapper — it was compiled against a
    # specific SDK and can report its prefix. On a fresh clone (before
    # provisioning) compile a temporary probe from the vendored source;
    # its baked-in default locates the SDK it was built for.
    _pw="${BAZELPORT_ROOT}/local_repos/python_wrapper/python3"
    if [ ! -x "${_pw}" ] && [ -f "${BAZELPORT_ROOT}/deps/files/python_wrapper/python3_wrapper.c" ] \
        && [ -n "${COMPILER_PATH:-}" ] && [ -x "${COMPILER_PATH}" ]; then
        _pw="/tmp/bazelport_python_probe.$$"
        /bin/env _CEE_RUNOPTS='POSIX(ON)' "${COMPILER_PATH}" -D_ALL_SOURCE=1 -fzos-le-char-mode=ascii -O2 \
            "${BAZELPORT_ROOT}/deps/files/python_wrapper/python3_wrapper.c" \
            -o "${_pw}" 2>/dev/null || _pw=""
    fi
    if [ -n "${_pw}" ] \
        && _pyprefix="$("${_pw}" -c "import sys; print(sys.prefix)" 2>/dev/null)" \
        && [ -n "${_pyprefix}" ] && [ -x "${_pyprefix}/bin/python3" ]; then
        PYTHON_HOME="${_pyprefix}"
    fi
    [ "${_pw}" = "/tmp/bazelport_python_probe.$$" ] && rm -f "${_pw}" 2>/dev/null
    unset _pw
fi
if [ -n "${PYTHON_HOME:-}" ] && [ -x "${PYTHON_HOME}/bin/python3" ]; then
    export PYTHON_HOME
fi
# NOTE: the HARD PYTHON_HOME check runs inside zopen_bazel_make — at source
# time (inside the EBCDIC zopen-build harness, before zopen sets up the
# dependency environments) the probe compile may not be possible.
export PYTHON_HOME

# --- ZOPEN_ROOTFS: env, else derive from zopen's own ZOPEN_OLD_PATH, else
# --- common locations. Must provide GNU tools in usr/local/altbin.
if [ -z "${ZOPEN_ROOTFS:-}" ]; then
    case ":${ZOPEN_OLD_PATH:-}:" in
        *:*/usr/local/bin:*)
            ZOPEN_ROOTFS="${ZOPEN_OLD_PATH%%:/usr/local/bin:*}"
            ;;
    esac
fi
if [ -z "${ZOPEN_ROOTFS}" ] || [ ! -x "${ZOPEN_ROOTFS}/usr/local/altbin/grep" ]; then
    for d in "${ZOPEN_ROOTFS:-}" /data/zopen /ZOPEN/zopen; do
        [ -n "$d" ] && [ -x "$d/usr/local/altbin/grep" ] && ZOPEN_ROOTFS="$d" && break
    done
fi
if [ -z "${ZOPEN_ROOTFS}" ] || [ ! -x "${ZOPEN_ROOTFS}/usr/local/altbin/grep" ]; then
    echo "ERROR: cannot locate the zopen rootfs (needs usr/local/altbin/grep). Set ZOPEN_ROOTFS." >&2
    return 1 2>/dev/null || exit 1
fi
export ZOPEN_ROOTFS

# --- zopen package dirs: env, else auto-detect under ZOPEN_ROOTFS
# --- (single-version glob)
_zopen_pkg() {  # $1 = env var name, $2 = package name
    _var="$1"; _pkg="$2"
    if [ -z "${!_var:-}" ] || [ ! -d "${!_var}" ]; then
        # prefer the active (unversioned) install symlink; else the newest
        # versioned .zos directory
        _hit=""
        [ -d "${ZOPEN_ROOTFS}/usr/local/zopen/${_pkg}/${_pkg}" ] && \
            _hit="${ZOPEN_ROOTFS}/usr/local/zopen/${_pkg}/${_pkg}"
        if [ -z "$_hit" ]; then
            _hit="$(ls -d "${ZOPEN_ROOTFS}/usr/local/zopen/${_pkg}/"*.zos 2>/dev/null | sort -V | tail -1)"
        fi
        if [ -n "$_hit" ]; then
            eval "export $_var=\"\$_hit\""
        else
            echo "WARNING: cannot locate zopen package '${_pkg}' under ZOPEN_ROOTFS (set ${_var} or install it)" >&2
        fi
    else
        export "$_var"
    fi
}
_zopen_pkg ZOSLIB_HOME zoslib
_zopen_pkg GRPC_HOME grpc
_zopen_pkg SQLITE_HOME sqlite
_zopen_pkg ZLIB_HOME zlib
_zopen_pkg OPENSSL_HOME openssl
unset -f _zopen_pkg

# ============================================================================
# local_repos provisioning: constructs ${BAZELPORT_ROOT}/local_repos from
# vendored tarballs (deps/), zopen system installs, the dist extract and a
# few generated artifacts. Everything the no-network build needs; nothing
# unnecessary is stored in the repository.
#
# Sources:
#   deps/*.tar.gz                    vendored upstream rule repos (no network)
#   deps/files/                      hand-written wrappers/scripts/templates
#   ${GRPC_HOME}, ${ZOPEN_ROOTFS}    zopen gRPC / protobuf / sqlite installs
#   ./third_party, ./derived         the extracted bazel dist (zopen build
#                                    extracts + patches it before make runs)
# ============================================================================
zopen_provision_local_repos() {
    _repos="${BAZELPORT_ROOT}/local_repos"
    _deps="${BAZELPORT_ROOT}/deps"
    _files="${_deps}/files"
    _GZIP="${ZOPEN_ROOTFS}/usr/local/bin/gzip"

    if [ -f "${_repos}/.provisioned" ]; then
        return 0
    fi
    echo "Provisioning local_repos (first run on this clone)..."
    mkdir -p "${_repos}"

    # --- 1. vendored rule repos -------------------------------------------
    for _t in "${_deps}"/*.tar.gz; do
        [ -e "$_t" ] || continue
        # protobuf-includes is extracted into com_google_protobuf below
        [ "$(basename "$_t")" = "protobuf-includes.tar.gz" ] && continue
        tar -I "${_GZIP}" -xf "$_t" -C "${_repos}" || {
            echo "ERROR: failed to extract $_t" >&2; return 1; }
    done

    # --- 1b. pristine upstream rule repos downloaded from GitHub -----------
    # (byte-identical to what the verified build used; the z/OS-patched and
    # version-sensitive repos stay vendored in deps/)
    _CURL="${ZOPEN_ROOTFS}/usr/local/bin/curl"
    _dl() {  # $1=url $2=dest — download with retries
        rm -f "$2"
        _n=0
        while [ $_n -lt 3 ]; do
            _n=$((_n+1))
            "${_CURL}" -sSL --retry 2 --max-time 300 -o "$2" "$1" 2>/dev/null
            if [ $? -eq 0 ] && [ -s "$2" ]; then return 0; fi
            rm -f "$2"
            sleep $((_n*5))
        done
        echo "ERROR: download failed: $1" >&2
        return 1
    }
    _dlrepo() {  # $1=name $2=url $3=strip_prefix
        [ -d "${_repos}/$1" ] && return 0
        echo "  downloading $1 ..."
        _dl "$2" "/tmp/bazelport_$1.tgz" || return 1
        rm -rf "/tmp/bazelport_x_$1" && mkdir -p "/tmp/bazelport_x_$1"
        tar -I "${_GZIP}" -xf "/tmp/bazelport_$1.tgz" -C "/tmp/bazelport_x_$1" || return 1
        # cp -R (NOT mv: cross-filesystem mv on z/OS drops files with
        # FSUM8985 uid/gid warnings)
        mkdir -p "${_repos}/$1"
        if [ -d "/tmp/bazelport_x_$1/$3" ]; then
            cp -R "/tmp/bazelport_x_$1/$3/." "${_repos}/$1/" || return 1
        else
            cp -R "/tmp/bazelport_x_$1/." "${_repos}/$1/" || return 1
        fi
        rm -rf "/tmp/bazelport_x_$1" "/tmp/bazelport_$1.tgz"
    }
    _dlrepo bazel_skylib \
        https://github.com/bazelbuild/bazel-skylib/releases/download/1.6.1/bazel-skylib-1.6.1.tar.gz \
        bazel-skylib-1.6.1 || return 1
    _dlrepo rules_license \
        https://github.com/bazelbuild/rules_license/releases/download/0.0.7/rules_license-0.0.7.tar.gz \
        rules_license-0.0.7 || return 1
    _dlrepo rules_pkg \
        https://github.com/bazelbuild/rules_pkg/releases/download/0.9.1/rules_pkg-0.9.1.tar.gz \
        rules_pkg-0.9.1 || return 1
    _dlrepo rules_jvm_external \
        https://github.com/bazelbuild/rules_jvm_external/archive/refs/tags/6.0.tar.gz \
        rules_jvm_external-6.0 || return 1
    # blake3: upstream release + local BUILD/WORKSPACE wrappers
    _dlrepo blake3 \
        https://github.com/BLAKE3-team/BLAKE3/archive/refs/tags/1.5.1.tar.gz \
        BLAKE3-1.5.1 || return 1
    cp "${_files}/blake3/BUILD" "${_files}/blake3/WORKSPACE" "${_repos}/blake3/"
    # stardoc: upstream release + trimmed WORKSPACE (upstream's includes
    # INTERNAL-ONLY dev dependencies that need network)
    _dlrepo stardoc \
        https://github.com/bazelbuild/stardoc/archive/refs/tags/0.5.6.tar.gz \
        stardoc-0.5.6 || return 1
    cp "${_files}/stardoc/WORKSPACE" "${_repos}/stardoc/WORKSPACE"
    unset -f _dl _dlrepo

    # --- 2. gRPC wrapper: zopen headers + lib symlinks + plugin wrapper ---
    if [ -z "${GRPC_HOME:-}" ] || [ ! -d "${GRPC_HOME}/include" ]; then
        echo "ERROR: GRPC_HOME is not set/valid — install the zopen grpc package or export GRPC_HOME" >&2
        return 1
    fi
    _g="${_repos}/com_github_grpc_grpc"
    mkdir -p "${_g}/includes" "${_g}/lib" "${_g}/src/compiler"
    cp -R "${GRPC_HOME}/include/grpc" "${_g}/includes/grpc"
    cp -R "${GRPC_HOME}/include/grpcpp" "${_g}/includes/grpcpp"
    # old-layout headers (grpc++): prefer the zopen merged include tree,
    # fall back to the grpc package's own include dir; warn if absent
    _gi="${ZOPEN_ROOTFS}/usr/local/include/grpc++"
    [ -d "${_gi}" ] || _gi="${GRPC_HOME}/include/grpc++"
    if [ -d "${_gi}" ]; then
        cp -R "${_gi}" "${_g}/includes/grpc++"
    else
        echo "WARNING: no old-layout grpc++ headers found; code including <grpc++/...> may fail" >&2
    fi
    for _a in libgrpc++_unsecure.a libgrpc_unsecure.a libgpr.a \
              libaddress_sorting.a libcares.a libgrpc.a libgrpc_plugin_support.a; do
        ln -sf "${GRPC_HOME}/lib/${_a}" "${_g}/lib/${_a}"
    done
    cp "${_files}/com_github_grpc_grpc/BUILD.in" "${_g}/BUILD.in"
    cp "${_files}/com_github_grpc_grpc/WORKSPACE" "${_g}/WORKSPACE"
    cp "${_files}/com_github_grpc_grpc/src/compiler/BUILD" "${_g}/src/compiler/BUILD"
    cp "${_files}/com_github_grpc_grpc/src/compiler/grpc_cpp_plugin.sh" "${_g}/src/compiler/grpc_cpp_plugin.sh"
    chmod +x "${_g}/src/compiler/grpc_cpp_plugin.sh"

    # --- 3. protobuf wrapper: vendored headers (must match the linked
    #        libprotobuf.a, which comes from the zopen grpc package — the
    #        merged zopen include tree can drift), dist jars, java BUILD
    #        stubs, protoc wrapper -------------------------------------------
    _p="${_repos}/com_google_protobuf"
    mkdir -p "${_p}/jars" "${_p}/java/core" "${_p}/java/util" "${_p}/lib"
    tar -I "${_GZIP}" -xf "${_deps}/protobuf-includes.tar.gz" -C "${_p}"
    # old-layout headers: include_grpc = zopen's grpc/*.h tree,
    # include_grpcxx = zopen's grpc++/*.h tree (needed by generated code);
    # fall back to the grpc package's own include dir when the merged
    # zopen include tree lacks them
    mkdir -p "${_p}/include_grpc" "${_p}/include_grpcxx"
    _gi="${ZOPEN_ROOTFS}/usr/local/include/grpc"
    [ -d "${_gi}" ] || _gi="${GRPC_HOME}/include/grpc"
    cp -R "${_gi}/." "${_p}/include_grpc/"
    _gi="${ZOPEN_ROOTFS}/usr/local/include/grpc++"
    [ -d "${_gi}" ] || _gi="${GRPC_HOME}/include/grpc++"
    if [ -d "${_gi}" ]; then
        cp -R "${_gi}/." "${_p}/include_grpcxx/"
    else
        echo "WARNING: no grpc++ old-layout headers for protobuf wrapper" >&2
    fi
    # protobuf java jars ship with the dist (derived/jars)
    for _j in derived/jars/protobuf~/java/core/libcore.jar \
              derived/jars/protobuf~/java/core/liblite.jar \
              derived/jars/protobuf~/java/util/libutil.jar; do
        [ -f "$_j" ] && cp "$_j" "${_p}/jars/" || {
            echo "ERROR: missing dist jar: $_j" >&2; return 1; }
    done
    ln -sf ../../jars/libcore.jar "${_p}/java/core/libcore.jar"
    ln -sf ../../jars/libutil.jar "${_p}/java/util/libutil.jar"
    # libprotobuf.a from the zopen merged lib (symlink to the grpc pkg's copy)
    ln -sf "${ZOPEN_ROOTFS}/usr/local/lib/libprotobuf.a" "${_p}/lib/libprotobuf.a"
    # protoc binary from the zopen grpc package
    ln -sf "${GRPC_HOME}/bin/protoc-31.0.0" "${_p}/protoc.bin"
    cp "${_files}/com_google_protobuf/BUILD.in" "${_p}/BUILD.in"
    cp "${_files}/com_google_protobuf/protoc_wrapper.sh.in" "${_p}/protoc_wrapper.sh.in"
    cp "${_files}/com_google_protobuf/WORKSPACE" "${_p}/WORKSPACE"
    cp "${_files}/com_google_protobuf/java/core.BUILD" "${_p}/java/core/BUILD"
    cp "${_files}/com_google_protobuf/java/util.BUILD" "${_p}/java/util/BUILD"

    # --- 4. sqlite3 wrapper -------------------------------------------------
    _s="${_repos}/sqlite3"
    mkdir -p "${_s}/include"
    cp "${SQLITE_HOME}/include/sqlite3.h" "${SQLITE_HOME}/include/sqlite3ext.h" "${_s}/include/" 2>/dev/null || {
        echo "ERROR: sqlite headers not found in ${SQLITE_HOME}" >&2; return 1; }
    cp "${_files}/sqlite3/BUILD.in" "${_s}/BUILD.in"
    cp "${_files}/sqlite3/WORKSPACE" "${_s}/WORKSPACE"

    # --- 5. zstd-jni wrapper: dist jar + BUILD -----------------------------
    _z="${_repos}/zstd-jni"
    mkdir -p "${_z}"
    cp derived/jars/zstd-jni~/libzstd-jni.jar "${_z}/" || {
        echo "ERROR: missing derived/jars/zstd-jni~/libzstd-jni.jar" >&2; return 1; }
    cp "${_files}/zstd-jni/BUILD" "${_z}/BUILD"
    cp "${_files}/zstd-jni/WORKSPACE" "${_z}/WORKSPACE"

    # --- 6. googleapis / remoteapis: copied from the patched dist extract ---
    for _r in googleapis remoteapis; do
        if [ -d "third_party/${_r}" ]; then
            mkdir -p "${_repos}/${_r}"
            cp -R "third_party/${_r}/." "${_repos}/${_r}/"
        else
            echo "ERROR: third_party/${_r} not found (run from the dist extract)" >&2
            return 1
        fi
    done

    # --- 7. cc tool wrapper + empty stub archives ---------------------------
    # Resolve the clang/clang++ drivers from COMPILER_PATH (already validated
    # by zopen_bazel_make via --version before provisioning runs). No
    # hardcoded paths: the wrapper template gets the drivers substituted in.
    _ccbin="${COMPILER_PATH:-}"
    if [ -n "${_ccbin}" ] && [ -d "${_ccbin}" ]; then
        _ccbin="$(ls "${_ccbin}"/clang "${_ccbin}"/clang-* 2>/dev/null | head -1)"
    fi
    if [ -z "${_ccbin}" ] || [ ! -x "${_ccbin}" ]; then
        _ccbin="$(command -v clang 2>/dev/null)"
    fi
    _ccxx="$(dirname "${_ccbin}")/clang++"
    [ -x "${_ccxx}" ] || _ccxx="$(ls "$(dirname "${_ccbin}")"/clang++* 2>/dev/null | head -1)"
    if [ -z "${_ccbin}" ] || [ ! -x "${_ccbin}" ] || [ -z "${_ccxx}" ] || [ ! -x "${_ccxx}" ]; then
        echo "ERROR: cannot resolve clang/clang++ drivers for the zos_cc wrapper" >&2
        return 1
    fi
    mkdir -p "${_repos}/zos_cc_tools" "${_repos}/zos_stub_libs"
    _tmpl "${_files}/zos_cc_tools/zos_cc" "${_repos}/zos_cc_tools/zos_cc" \
        -e "s|@CLANG@|${_ccbin}|g" \
        -e "s|@CLANGXX@|${_ccxx}|g"
    chmod +x "${_repos}/zos_cc_tools/zos_cc"
    cp "${_files}/zos_stub_libs/stub_dummy.c" "${_repos}/zos_stub_libs/stub_dummy.c"
    ( cd "${_repos}/zos_stub_libs" \
      && /bin/env _CEE_RUNOPTS='POSIX(ON)' "${_ccbin}" -c stub_dummy.c -o stub_dummy.o \
      && ar r librt.a stub_dummy.o && ar r libdl.a stub_dummy.o && ar r libpthread.a stub_dummy.o )

    # --- 8. python3 wrapper (LIBPATH-setting program object) ----------------
    _w="${_repos}/python_wrapper"
    mkdir -p "${_w}"
    cp "${_files}/python_wrapper/python3_wrapper.c" "${_w}/python3_wrapper.c"
    /bin/env _CEE_RUNOPTS='POSIX(ON)' "${_ccbin}" -D_ALL_SOURCE=1 -fzos-le-char-mode=ascii \
        -O2 "${_w}/python3_wrapper.c" -o "${_w}/python3" || {
        echo "ERROR: failed to compile python3 wrapper" >&2; return 1; }

    # --- 9. tag everything provisioned (ASCII text / binary) ----------------
    find "${_repos}" -type f -exec /bin/chtag -b {} + 2>/dev/null
    find "${_repos}" -type f \
        \! -name "*.jar" \! -name "*.a" \! -name "*.so" \! -name "*.o" \
        \! -name "*.gz" \! -name "python3" \
        -exec /bin/chtag -tc ISO8859-1 {} + 2>/dev/null

    touch "${_repos}/.provisioned"
    echo "local_repos provisioning complete."
    unset _repos _deps _files _g _p _s _z _w _t _a _j _r
}

zopen_bazel_make() {
    echo "==== Bazel Full Build (Stage 1 + Stage 2) ===="

    # If zopen trapped us in the .bazelci subfolder, step out to the real root
    if [ ! -f "compile.sh" ] && [ -f "../compile.sh" ]; then
        cd ..
    fi

    # --- Apply the z/OS patches to the dist extract (zopen build does NOT
    # --- do this itself: a fresh git clone leaves the .patch files untagged,
    # --- which breaks the EBCDIC patch tooling; we tag them first).
    # --- Idempotent: skipped when the extract is already patched.
    if ! grep -q "z/OS" compile.sh 2>/dev/null; then
        echo "Applying stable-patches to the dist extract..."
        find "${BAZELPORT_ROOT}/stable-patches" -name "*.patch" -type f \
            -exec /bin/chtag -tc ISO8859-1 {} + 2>/dev/null
        # patch binary: use $PATCH_BIN if set; otherwise search PATH for
        # 'patch', SKIPPING the USS /bin and /usr/bin patch (FSUM patch is
        # known-broken for these patches: fails on 0004+). Echo which one
        # we picked so the build log shows it.
        _patchbin="${PATCH_BIN:-}"
        if [ -z "${_patchbin}" ] || [ ! -x "${_patchbin}" ]; then
            _saveIFS="${IFS}"
            IFS=:
            for _d in ${PATH}; do
                [ -n "${_d}" ] && [ -x "${_d}/patch" ] || continue
                case "${_d}" in
                    /bin|/usr/bin) continue ;;
                esac
                _patchbin="${_d}/patch"
                break
            done
            IFS="${_saveIFS}"
            unset _d _saveIFS
        fi
        if [ -z "${_patchbin}" ] || [ ! -x "${_patchbin}" ]; then
            echo "ERROR: cannot locate a usable patch binary (USS /bin patch is not sufficient)" >&2
            echo "       hint: put zopen's patch on PATH or export PATCH_BIN=/path/to/patch" >&2
            return 1
        fi
        echo "Using patch binary: ${_patchbin}"
        for _p in "${BAZELPORT_ROOT}"/stable-patches/*.patch; do
            [ -e "$_p" ] || continue
            # _CEE_RUNOPTS override: the zopen-build harness runs with
            # FILETAG(AUTOCVT,AUTOTAG) which corrupts patch's file writes;
            # each exec'd process reads _CEE_RUNOPTS anew, so override it.
            /bin/env _CEE_RUNOPTS='POSIX(ON)' "${_patchbin}" -p1 --silent --force \
                < "$_p" >/dev/null 2>&1 || {
                echo "ERROR: failed to apply $(basename "$_p")" >&2
                return 1
            }
        done
        unset _p _patchbin
    fi

    # --- Tag the vendored deps (a fresh git clone leaves all files
    # --- untagged; clang/patch read untagged ASCII as EBCDIC garbage).
    find "${BAZELPORT_ROOT}/deps" -type f -exec /bin/chtag -b {} + 2>/dev/null
    find "${BAZELPORT_ROOT}/deps" -type f \! -name "*.tar.gz" \
        -exec /bin/chtag -tc ISO8859-1 {} + 2>/dev/null

    # HARD check: the Python SDK must be locatable now (the source-time
    # probe is best-effort; the zopen-build harness cannot always run it).
    # Re-probe here: our bash environment and PATH are now fully set up.

    # --- Fix up COMPILER_PATH first (the probe below needs it): accept a
    # --- bare compiler path or a directory containing clang. Candidates
    # --- are VALIDATED by running --version (broken symlinks and
    # --- non-executable stubs like the Open XL dir's 'clang' entry are
    # --- skipped); fall back to 'command -v clang'.
    _cc_ok() { [ -n "${1:-}" ] && [ -x "${1}" ] && "${1}" --version >/dev/null 2>&1; }
    if ! _cc_ok "${COMPILER_PATH:-}"; then
        _ccsaved="${COMPILER_PATH:-}"
        _cands=""
        if [ -d "${_ccsaved}" ]; then
            _cands="$(ls "${_ccsaved}"/clang "${_ccsaved}"/clang-* 2>/dev/null)"
        elif [ -n "${_ccsaved}" ]; then
            _cands="${_ccsaved}"
        fi
        _cands="${_cands} $(command -v clang 2>/dev/null)"
        for _c in ${_cands}; do
            if _cc_ok "${_c}"; then
                COMPILER_PATH="${_c}"
                export COMPILER_PATH
                break
            fi
        done
        unset _c _cands _ccsaved
    fi
    unset -f _cc_ok 2>/dev/null

    # --- Derive JAVA_HOME from java/javac on PATH when not set or not a
    # --- full JDK: the bootstrap compile (JavacBootstrap) needs bin/javac.
    if [ -z "${JAVA_HOME:-}" ] || [ ! -x "${JAVA_HOME}/bin/javac" ]; then
        _jbin="$(command -v javac 2>/dev/null)"
        [ -z "${_jbin}" ] && _jbin="$(command -v java 2>/dev/null)"
        if [ -n "${_jbin}" ]; then
            _jhome="$(cd "$(dirname "${_jbin}")/.." && pwd)"
            if [ -x "${_jhome}/bin/javac" ]; then
                JAVA_HOME="${_jhome}"
                export JAVA_HOME
            fi
            unset _jhome
        fi
        unset _jbin
    fi
    if [ -z "${JAVA_HOME:-}" ] || [ ! -x "${JAVA_HOME}/bin/javac" ]; then
        echo "ERROR: JAVA_HOME must point at a JDK (needs bin/javac), e.g. the IBM Semeru z/OS JDK." >&2
        return 1
    fi

    # --- Derive PYTHON_HOME from the python3/python on PATH when not set:
    # --- PYTHON_HOME is the SDK root (bin/python3, lib/, ...).
    if [ -z "${PYTHON_HOME:-}" ] || [ ! -x "${PYTHON_HOME}/bin/python3" ]; then
        _pybin="$(command -v python3 2>/dev/null)"
        [ -z "${_pybin}" ] && _pybin="$(command -v python 2>/dev/null)"
        if [ -n "${_pybin}" ]; then
            _pyprefix="$(dirname "$(dirname "${_pybin}")")"
            if [ -x "${_pyprefix}/bin/python3" ]; then
                PYTHON_HOME="${_pyprefix}"
                export PYTHON_HOME
            fi
            unset _pyprefix
        fi
        unset _pybin
    fi
    if [ -z "${PYTHON_HOME:-}" ] || [ ! -x "${PYTHON_HOME}/bin/python3" ]; then
        _pw="${BAZELPORT_ROOT}/local_repos/python_wrapper/python3"
        if [ ! -x "${_pw}" ] && [ -f "${BAZELPORT_ROOT}/deps/files/python_wrapper/python3_wrapper.c" ]; then
            _pw="/tmp/bazelport_python_probe.$$"
            /bin/env _CEE_RUNOPTS='POSIX(ON)' "${COMPILER_PATH}" -D_ALL_SOURCE=1 -fzos-le-char-mode=ascii -O2 \
                "${BAZELPORT_ROOT}/deps/files/python_wrapper/python3_wrapper.c" \
                -o "${_pw}" 2>/dev/null || _pw=""
        fi
        if [ -n "${_pw}" ] \
            && _pyprefix="$("${_pw}" -c "import sys; print(sys.prefix)" 2>/dev/null)" \
            && [ -x "${_pyprefix}/bin/python3" ]; then
            PYTHON_HOME="${_pyprefix}"
            export PYTHON_HOME
        fi
        [ "${_pw}" = "/tmp/bazelport_python_probe.$$" ] && rm -f "${_pw}" 2>/dev/null
        unset _pw
    fi
    if [ -z "${PYTHON_HOME:-}" ] || [ ! -x "${PYTHON_HOME}/bin/python3" ]; then
        echo "ERROR: PYTHON_HOME must point at the Python SDK (needs bin/python3, e.g. the IBM Open Enterprise SDK for Python)." >&2
        return 1
    fi

    # python3 for build actions (build_tar wrappers, genrules). The wrapper
    # sets LIBPATH itself — bazel action spawns don't inherit the server's.
    # Honor a pre-set PYTHON_BIN_PATH only if it actually works (login envs
    # may carry a stale one); otherwise use the port's LIBPATH-setting wrapper.
    if [ ! -x "${PYTHON_BIN_PATH:-}" ]; then
        export PYTHON_BIN_PATH="${BAZELPORT_ROOT}/local_repos/python_wrapper/python3"
    fi
    export LIBPATH="${PYTHON_HOME}/lib:${LIBPATH:-}"
    # NOTE: altbin MUST come first — the z/OS USS tools in /bin (FSUM) don't
    # support grep -o or find -mindepth, which Stage 1's link_file/embedding
    # steps require.
    export PATH="${ZOPEN_ROOTFS}/usr/local/altbin:${JAVA_HOME}/bin:${BAZELPORT_ROOT}/local_repos/python_wrapper:${ZOPEN_ROOTFS}/usr/local/bin:$(dirname "$COMPILER_PATH"):$PATH"
    export CC=${CC:-clang}
    export CXX=${CXX:-clang++}
    # z/OS: identify the libc to the auto-configured cc toolchain
    export BAZEL_TARGET_LIBC=zos
    # Genrule actions exec /bin/bash by default (local_config_shell falls
    # back to it). Machines without /bin/bash fail every genrule spawn with
    # EXECUTION_FAILED — point Bazel at the bash found on PATH instead
    # (BAZEL_SH/SHELL are both honored before the /bin/bash fallback).
    if [ ! -x /bin/bash ]; then
        _bashbin="$(command -v bash 2>/dev/null)"
        if [ -n "${_bashbin}" ]; then
            export BAZEL_SH="${_bashbin}"
            export SHELL="${_bashbin}"
            echo "Note: /bin/bash not present; using ${_bashbin} for genrule shell" >&2
        else
            echo "ERROR: no /bin/bash and no bash on PATH — genrules cannot run" >&2
            return 1
        fi
    fi
    export LC_ALL=${LC_ALL:-C.UTF-8}
    # z/OS: Tag generated scripts for exec() but don't corrupt binary file reads
    export _TAG_REDIR_IN=txt=ISO8859-1
    export _TAG_REDIR_OUT=bin
    unset _TAG_REDIR_ALL
    # JVM console output: pin to ISO8859-1 so JVM messages (server logs,
    # javac notes) are ASCII, not the native EBCDIC codepage — the main source
    # of garbled blobs in zopen build logs. (stdout/stderr encoding is separate
    # from file.encoding; Java 18+ honors these properties.)
    export JAVA_TOOL_OPTIONS="-Dfile.encoding=UTF-8 -Dstdout.encoding=ISO8859-1 -Dstderr.encoding=ISO8859-1 ${JAVA_TOOL_OPTIONS:-}"
    # Explicit annotation processors (discovery is unreliable on z/OS javac)
    export BAZEL_JAVAC_OPTS="-processor com.google.auto.value.processor.AutoValueProcessor,com.google.auto.value.processor.AutoOneOfProcessor -J-Xmx4g -J-Xms2g"
    # --color=no: bazel terminal progress (spinners, ANSI) renders as garbled
    # EBCDIC in zopen logs; disable colors to reduce the noise.
    export EXTRA_BAZEL_ARGS="--tool_java_runtime_version=local_jdk --java_runtime_version=local_jdk --spawn_strategy=standalone --features=no_dotd_file --cxxopt=-std=c++17 --host_cxxopt=-std=c++17 --@rules_jvm_external//settings:stamp_manifest=False --color=no --show_progress=no"
    export VERBOSE=${VERBOSE:-no}

    # CRITICAL: normal mode for Stage 2 (full WORKSPACE machinery).
    # Never leave ZOS_BOOTSTRAP_MODE set here — that would stop at the
    # bootstrap jar and treat Stage 1 as the final product.
    unset ZOS_BOOTSTRAP_MODE

    hash -r
    # z/OS file tagging: the dist extract leaves files UNTAGGED, which
    # clang action spawns (running without _TAG_REDIR) read as EBCDIC
    # garbage ("unexpected character <U+0080>"). Tag the tree: everything
    # binary (raw bytes for ASCII-mode compilers), then text extensions as
    # ISO8859-1 so EBCDIC shell tools (/bin/sh) can read scripts. Idempotent.
    if find src -name "*.cc" -type f -exec /bin/chtag -p {} + 2>/dev/null | grep -q -- "- untagged"; then
        echo "Tagging source tree (untagged files detected)..."
        find . -type f \
            \! -path "*/.git/*" \! -path "./output/*" \! -path "./bazel-*" \
            \! -path "*/bazel-out/*" \! -path "./derived/*" \
            -exec /bin/chtag -b {} + 2>/dev/null
        # same for the port's local_repos (a fresh git clone loses all file
        # tags; clang/grpc header includes are read from there)
        find "${BAZELPORT_ROOT}/local_repos" -type f \
            \! -path "*/.git/*" \
            -exec /bin/chtag -b {} + 2>/dev/null
        # text-tag everything that is not a known binary type (covers
        # extensionless BUILD-adjacent files, dotfiles, scripts, sources).
        # NOTE: files read by the JVM via NIO (Files.newBufferedReader — e.g.
        # bazel_downloader.cfg, *.json, *.options) MUST stay BINARY-tagged:
        # z/OS converts text-tagged files to the process codepage on read,
        # which breaks UTF-8 decoding (MalformedInputException).
        # *.in templates stay binary (raw byte reads by _tmpl's sed);
        # python_wrapper/* holds program objects (must stay binary).
        for _tagroot in . "${BAZELPORT_ROOT}/local_repos"; do
        find "${_tagroot}" -type f \
            \! -path "*/.git/*" \! -path "./output/*" \! -path "./bazel-*" \
            \! -path "*/bazel-out/*" \! -path "./derived/*" \
            \! -name "*.jar" \! -name "*.zip" \! -name "*.war" \! -name "*.ear" \
            \! -name "*.class" \! -name "*.so" \! -name "*.a" \! -name "*.o" \
            \! -name "*.dll" \! -name "*.exe" \! -name "*.png" \! -name "*.jpg" \
            \! -name "*.jpeg" \! -name "*.gif" \! -name "*.ico" \! -name "*.pdf" \
            \! -name "*.tar" \! -name "*.gz" \! -name "*.tgz" \! -name "*.jar.exe" \
            \! -name "*.zip.exe" \
            \! -name "*.cfg" \! -name "*.options" \! -name "*.version" \
            \! -name "*.json" \! -name "*.bazelrc" \! -name "*.patch" \
            \! -name "*.in" \! -path "*/python_wrapper/*" \
            -exec /bin/chtag -tc ISO8859-1 {} + 2>/dev/null
        done
        echo "Tree tagging complete."
    fi
    # Provision local_repos on first use (fresh clone); idempotent.
    # _tmpl must be defined first: provisioning uses it to generate the
    # zos_cc wrapper (templated compiler paths) from deps/files templates.
    _tmpl() {  # $1=template $2=out; remaining args are sed expressions
        _in="$1"; _out="$2"; shift 2
        # The .in templates are BINARY-tagged (raw byte reads). The zopen-build
        # harness runs EBCDIC-native with _CEE_RUNOPTS FILETAG(AUTOCVT,
        # AUTOTAG): newly created files are auto-tagged in the native codepage
        # and ASCII writes get converted to EBCDIC, breaking Bazel's Starlark
        # parsing ("target not declared in package"). _CEE_RUNOPTS cannot be
        # changed at runtime (read once at LE init), so PRE-CREATE the output
        # with the correct tag: the shell's truncating redirect (>) preserves
        # an existing file tag, making the write codepage-stable.
        #   *.sh, *zos_cc -> ISO8859-1 text (readable by EBCDIC /bin/sh AND
        #                    ASCII bash; zos_cc is a #!/bin/sh script)
        #   BUILD -> binary (read raw by Bazel's JVM; text tags make NIO
        #            reads convert to the native codepage and corrupt UTF-8)
        case "${_out}" in
            *.sh|*zos_cc) _tflag="-tc ISO8859-1" ;;
            *)    _tflag="-b" ;;
        esac
        rm -f "${_out}.tmp"
        : > "${_out}.tmp"
        /bin/chtag ${_tflag} "${_out}.tmp" 2>/dev/null
        ( unset _TAG_REDIR_OUT _TAG_REDIR_ALL; sed "$@" "${_in}" > "${_out}.tmp" )
        mv -f "${_out}.tmp" "${_out}"
        chmod --reference="${_in}" "${_out}" 2>/dev/null || true
        /bin/chtag ${_tflag} "${_out}" 2>/dev/null || true
    }
    zopen_provision_local_repos || return 1

    # Generate local_repos wrapper BUILD files from .in templates: they wrap
    # system-installed zopen artifacts, and BUILD files cannot read the
    # environment, so the paths are templated and substituted here.
    _repos="${BAZELPORT_ROOT}/local_repos"
    _gr="${GRPC_HOME:-${ZOPEN_ROOTFS}/usr/local/zopen/grpc/grpc}"
    _tmpl "${_repos}/com_github_grpc_grpc/BUILD.in" "${_repos}/com_github_grpc_grpc/BUILD" \
        -e "s|@GRPC_LIB_DIR@|${_gr}/lib|g"
    _tmpl "${_repos}/com_google_protobuf/BUILD.in" "${_repos}/com_google_protobuf/BUILD" \
        -e "s|@GRPC_LIB_DIR@|${_gr}/lib|g" \
        -e "s|@ZLIB_LIB@|${ZLIB_HOME}/lib/libz.a|g" \
        -e "s|@ZOSLIB_A@|${ZOSLIB_HOME}/lib/libzoslib.a|g" \
        -e "s|@PROTOC@|${ZOPEN_ROOTFS}/usr/local/bin/protoc|g"
    _tmpl "${_repos}/com_google_protobuf/protoc_wrapper.sh.in" "${_repos}/com_google_protobuf/protoc_wrapper.sh" \
        -e "s|@PROTOC_BIN@|${_gr}/bin/protoc-31.0.0|g"
    _tmpl "${_repos}/sqlite3/BUILD.in" "${_repos}/sqlite3/BUILD" \
        -e "s|@SQLITE_LIB@|${SQLITE_HOME}/lib/libsqlite3.a|g" \
        -e "s|@SQLITE_INC@|${SQLITE_HOME}/include|g"
    unset -f _tmpl

    # --- TMPDIR: /tmp on z/OS is often a tiny FS that fills up during
    # --- compile.sh's jar-unzip scratch dirs. Use a dir under the build
    # --- root instead (honored by compile.sh / mktemp / unzip wrappers).
    mkdir -p "${BAZELPORT_ROOT}/tmp"
    export TMPDIR="${BAZELPORT_ROOT}/tmp"
    echo "Using TMPDIR: ${TMPDIR}"

    echo "Running FULL Bazel compile.sh in $(pwd)..."
    bash ./compile.sh
    rc=$?
    if [ $rc -ne 0 ]; then
        echo "ERROR: compile.sh failed with exit code $rc" >&2
        return $rc
    fi

    # Final artifact check: must be the Stage 2 binary, NOT the bootstrap jar.
    if [ ! -f "output/bazel" ]; then
        echo "ERROR: output/bazel (Stage 2 binary) was not created — build did not complete Stage 2" >&2
        return 1
    fi
    if [ ! -s "output/bazel" ]; then
        echo "ERROR: output/bazel is empty" >&2
        return 1
    fi
    echo "Stage 2 complete: output/bazel ($(ls -l output/bazel | awk '{print $5}') bytes)"
    return 0
}

# Custom install step: install the Stage 2 binary
zopen_bazel_install() {
    # Step out to the real root if needed
    if [ ! -d "output" ] && [ -d "../output" ]; then
        cd ..
    fi

    # Refuse to install unless the Stage 2 binary exists — the bootstrap
    # jar (output/libblaze.jar) is never a valid install artifact.
    if [ ! -f "output/bazel" ]; then
        echo "ERROR: output/bazel not found — refusing to install (bootstrap-only builds are not final)" >&2
        return 1
    fi

    echo "Installing Bazel (Stage 2 binary) from $(pwd)..."
    mkdir -p "${ZOPEN_INSTALL_DIR}/bin"
    cp output/bazel "${ZOPEN_INSTALL_DIR}/bin/"
}
