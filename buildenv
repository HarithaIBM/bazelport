zopen_unpack_zip() {
  local tarball="$1"
  local targetdir="$2"
  
  echo "[zopen_unpack_zip] Custom unpack for Bazel dist zip" >&2
  echo "[zopen_unpack_zip] Tarball: $tarball" >&2
  echo "[zopen_unpack_zip] Target: $targetdir" >&2
  
  # Create target directory
  mkdir -p "$targetdir"
  
  # Extract into target directory
  cd "$targetdir"
  unzip -o -q "$tarball"
  
  echo "[zopen_unpack_zip] Extracted $(find . -type f | wc -l) files" >&2
  ls -la | head -20 >&2
  
  return 0
}

