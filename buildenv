zopen_init(){
  # Apply z/OS specific patches for protobuf compatibility
  echo "Setting up z/OS build configuration..." >&2
  
  # Add z/OS configuration to Bazel args
  export EXTRA_BAZEL_ARGS="${EXTRA_BAZEL_ARGS:-} --config=zos"
  
  echo "[zopen_init] Using unzip from PATH: $(which unzip)" >&2
  echo "Using EXTRA_BAZEL_ARGS: $EXTRA_BAZEL_ARGS" >&2
}

zopen_post_buildenv(){
  ## This function runs after the 'buildenv' is processed.
  echo "[zopen_post_buildenv] Using system unzip: $(which unzip)" >&2
}

zopen_post_extract(){
  ## This function runs after the source tarball is extracted.
  local sourcedir="$1"
  
  echo "[zopen_post_extract] Post-extraction fixes for sourcedir: ${sourcedir}" >&2
  
  # Change to source directory
  cd "${sourcedir}" || {
    echo "[zopen_post_extract] ERROR: Could not cd to ${sourcedir}" >&2
    return 1
  }
  
  echo "[zopen_post_extract] Working in: $(pwd)" >&2
  
  # Tag all binary files in derived directory if it exists
  if [ -d "derived" ]; then
    echo "[zopen_post_extract] Tagging binary files in derived directory..." >&2
    find "derived" \( -name "*.jar" -o -name "*.so" -o -name "*.a" \) -exec /bin/chtag -b {} \; 2>&1 | head -5
  fi
  
  # z/OS: Apply critical patch to unix_cc_configure.bzl for script encoding
  echo "[zopen_post_extract] Applying z/OS patch to unix_cc_configure.bzl..." >&2
  local bzl_file="tools/cpp/unix_cc_configure.bzl"
  if [ -f "${bzl_file}" ]; then
    # Use our patch script (go back to original repo dir)
    if [ -f "/home/haritha/code/bazelport/patches/patch_unix_cc_configure.sh" ]; then
      bash /home/haritha/code/bazelport/patches/patch_unix_cc_configure.sh "${bzl_file}" >&2
    else
      echo "[zopen_post_extract] WARNING: patch script not found" >&2
    fi
  else
    echo "[zopen_post_extract] WARNING: Could not find unix_cc_configure.bzl at ${bzl_file}" >&2
    echo "[zopen_post_extract] Files in tools/cpp:" >&2
    ls -la tools/cpp/*.bzl 2>&1 | head -5 >&2
  fi
  
  # Tag all shell scripts as ASCII
  echo "[zopen_post_extract] Tagging shell scripts as ASCII..." >&2
  find "tools" -name "*.sh" -exec /bin/chtag -tc ISO8859-1 {} \; 2>&1 | head -5
  find "third_party" -name "*.sh" -exec /bin/chtag -tc ISO8859-1 {} \; 2>&1 | head -5
  find "scripts" -name "*.sh" -exec /bin/chtag -tc ISO8859-1 {} \; 2>&1 | head -5
  
  echo "[zopen_post_extract] Completed successfully" >&2
  return 0
}



