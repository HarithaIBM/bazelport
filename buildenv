# Custom compile step for Bazel (Zip Bomb Fix)
zopen_bazel_make() {
###echo "==== BEFORE compile.sh ====="
# Use ZOPEN_ROOTFS if set, otherwise fallback to /data/zopen
ZOPEN_BASE="${ZOPEN_ROOTFS:-/data/zopen}"
export PATH=${ZOPEN_BASE}/usr/local/altbin:${ZOPEN_BASE}/usr/local/bin:$PATH
# z/OS: Explicitly specify annotation processors to avoid auto-discovery
# Auto-discovery triggers module resolution for checker-qual and errorprone-annotations
# We only need AutoValue processors for code generation
export BAZEL_JAVAC_OPTS="-processor com.google.auto.value.processor.AutoValueProcessor,com.google.auto.value.processor.AutoOneOfProcessor"
# Disabled annotation processors as they cause javac to hang on z/OS
# export BAZEL_JAVAC_OPTS="-processor \
# com.google.auto.value.processor.AutoValueProcessor,\
# com.google.auto.value.processor.AutoOneOfProcessor,\
# com.google.auto.service.processor.AutoServiceProcessor"
hash -r

export EXTRA_BAZEL_ARGS="\
--tool_java_runtime_version=local_jdk \
--java_runtime_version=local_jdk \
--tool_java_language_version=21 \
--java_language_version=21 "
#export EXTRA_BAZEL_ARGS="--tool_java_runtime_version=local_jdk"
##echo "PATH=$PATH"
##which grep
##type grep
##grep --version
##echo "PATH=$PATH"
##which grep
##type grep
##grep --version || true

#echo "============================="    # If zopen trapped us in the .bazelci subfolder, step out to the real root
    if [ ! -f "compile.sh" ] && [ -f "../compile.sh" ]; then
        cd ..
    fi
    
    echo "Running Bazel compile.sh in $(pwd)..."
    ZOPEN_BASE="${ZOPEN_ROOTFS:-/data/zopen}"
    export PATH=${ZOPEN_BASE}/usr/local/bin:$PATH
    
    # Check if derived directory exists (required for dist archive)
    if [ ! -d "derived" ]; then
        echo "ERROR: 'derived' directory not found - this may not be a proper dist archive extraction" >&2
        echo "Current directory: $(pwd)" >&2
        echo "Contents: $(ls -la | head -20)" >&2
        return 1
    fi
    
    hash -r
    chmod +x compile.sh
    
    # z/OS: Set OUTPUT_DIR to use local output directory instead of /tmp
    export OUTPUT_DIR="$(pwd)/output"
    mkdir -p "${OUTPUT_DIR}"
    
    bash ./compile.sh
    rc=$?
    if [ $rc -ne 0 ]; then
        echo "ERROR: compile.sh failed with exit code $rc" >&2
        return $rc
    fi
    
    # Verify output/bazel was created
    if [ ! -f "output/bazel" ]; then
        echo "ERROR: output/bazel was not created by compile.sh" >&2
        return 1
    fi
    
    echo "Bazel binary successfully built at output/bazel"
    return 0
}

# Custom install step (Zip Bomb Fix)
zopen_bazel_install() {
    # Step out to the real root if needed
    if [ ! -d "output" ] && [ -d "../output" ]; then
        cd ..
    fi
    
    echo "Installing Bazel from $(pwd)..."
    mkdir -p "${ZOPEN_INSTALL_DIR}/bin"
    cp output/bazel "${ZOPEN_INSTALL_DIR}/bin/"
}
